<Layouts.app flash={@flash}>
  <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="rounded-2xl border border-zinc-200 bg-white p-8 shadow-sm">
      <p class="text-sm font-semibold uppercase tracking-wide text-zinc-500">Birthday Reminder</p>
      <h1 class="mt-2 text-4xl font-semibold tracking-tight text-zinc-900">
        Keep birthday contacts in one simple place.
      </h1>
      <p class="mt-4 text-base text-zinc-600">
        Track a name, birthday, and phone number. Nothing fancy, just the essentials.
      </p>
      <div class="mt-8 flex gap-4">
        <.link
          navigate={~p"/birthdays"}
          class="rounded-lg bg-zinc-900 px-4 py-2 text-sm font-semibold text-white hover:bg-zinc-700"
        >
          View birthdays
        </.link>
        <.link
          navigate={~p"/birthdays/new"}
          class="rounded-lg border border-zinc-300 px-4 py-2 text-sm font-semibold text-zinc-900 hover:bg-zinc-50"
        >
          Add a birthday
        </.link>
      </div>
    </div>
  </div>
</Layouts.app>
